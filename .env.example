# Copy to .env for local development. Never commit real secrets.

# The one application database, used by host scripts and the Docker containers alike.
# Neon: use the direct (non "-pooler") connection string with sslmode=verify-full.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# DB_CONNECT_TIMEOUT_MS=10000

# Test-only database. The e2e suite DROPS its schema and refuses names not ending in _test,
# so it runs on the local disposable container: `docker compose up -d db`.
TEST_DATABASE_URL=postgres://ajodesk:ajodesk_local_only@127.0.0.1:5433/ajodesk_test
# Local test container settings.
POSTGRES_PASSWORD=ajodesk_local_only
DB_PORT=5433

API_PORT=3001
WEB_PORT=3000
# Web → API base URL, used server-side only (apps/web never exposes it to the browser).
API_URL=http://localhost:3001
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
JWT_EXPIRES_IN_SECONDS=3600
# HMAC pepper for integration keys. Rotating it invalidates every issued key.
INTEGRATION_KEY_PEPPER=replace-with-another-32-plus-random-characters-xx
INTENT_TTL_MINUTES=15
CORS_ORIGINS=http://localhost:3000
AUTH_RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY=false
ENABLE_API_DOCS=true

# Demo seed (fictional data only).
DEMO_COLLECTOR_EMAIL=demo.collector@ajodesk.test
DEMO_COLLECTOR_PASSWORD=change-me-demo-password
